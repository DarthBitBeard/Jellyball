# Jellyball configuration template.
#
# Copy this file to `.env` in the same folder (running from source or
# Docker), or edit the `.env` the installer wrote to
# %ProgramData%\Jellyball\.env (Windows service) directly.
#
# Precedence (highest wins): real process environment variables > the data
# directory's .env (per-user for the tray app; %ProgramData%\Jellyball\.env
# for the service; the file Docker's env_file/environment populates) > a
# .env file sitting beside the executable/source (package-wide defaults).
#
# Every line below is commented out at its built-in default. Uncomment and
# edit only what you need to change. See Jellyball/README.md for the full
# description of each setting, and which ones can also be changed live from
# the dashboard's Advanced Settings / Provider Domains without a restart.

# ==========================================================================
# Server & auth
# ==========================================================================

# TCP port the dashboard and streaming endpoints listen on.
#PORT=8000

# Bind address. Loopback-only by default on Windows; 0.0.0.0 by default
# everywhere else (Docker, Linux). Binding beyond loopback requires a
# dashboard password (see DASHBOARD_PASSWORD below).
#JELLYBALL_HOST=127.0.0.1

# Override the writable data directory (settings DB, logs, generated
# password file, Multi-View scratch space). Defaults to
# %LOCALAPPDATA%\Jellyball / %ProgramData%\Jellyball (service) on Windows,
# $XDG_DATA_HOME/Jellyball or ~/.local/share/Jellyball elsewhere, and
# /app/data in the Docker image.
#JELLYBALL_DATA_DIR=

# SQLite database file. Relative paths are stored inside the data directory.
#DB_FILE=sports_proxy.db

# Dashboard sign-in. Leave DASHBOARD_PASSWORD blank on a loopback bind to run
# without a password. On a network bind, a blank password makes Jellyball
# generate one on first start and save it to dashboard-password.txt in the
# data directory (Docker also prints it to `docker logs`).
#DASHBOARD_USERNAME=admin
#DASHBOARD_PASSWORD=

# Trust X-Forwarded-Host when checking CSRF Origin. Leave off unless Jellyball
# sits behind a reverse proxy that overwrites that header; browsers can
# otherwise spoof it and bypass the cross-site write check.
#TRUST_X_FORWARDED_HOST=0

# Force a single worker process; Jellyball is not safe to run with more than
# one (in-memory session/health state). Setting this to anything else stops
# startup with an error.
#WEB_CONCURRENCY=1

# How long to wait for the configured port to become free before giving up
# at startup (seconds).
#PORT_BIND_WAIT_SECONDS=30

# Run without the system tray/GUI even on Windows (the installer's service
# sets this itself; you shouldn't need to on a desktop install).
#JELLYBALL_HEADLESS=

# Comma-separated provider names (e.g. iSportSurge,MyBuffStreams) used to
# break ties between otherwise-equal stream candidates.
#STREAM_PROVIDER_PRIORITY=

# Override the User-Agent header used for scraping and stream probes.
# Defaults to a Chrome build matching the pinned Playwright Chromium.
#JELLYBALL_USER_AGENT=

# Allow scrapers/probes to fetch private/loopback/link-local addresses.
# Leave this off unless you know why you need it - it exists for local
# testing, and disables an SSRF guard.
#ALLOW_PRIVATE_UPSTREAMS=0

# Timeout for a single DNS resolution during upstream URL validation.
#DNS_RESOLVE_TIMEOUT=2.0

# ==========================================================================
# Jellyfin
# ==========================================================================

# Base URL of your Jellyfin server (used for the "Refresh Guide" button and
# provider event-time lookups against Jellyfin's own task API).
#JELLYFIN_URL=http://localhost:8096

# Jellyfin API key (Dashboard > API Keys). Required for the "Refresh Guide"
# button and the auto-refresh feature below.
#JELLYFIN_API_KEY=

# Jellyfin scheduled-task ID for "Refresh Guide Data" (auto-detected if left
# blank and an API key is set).
#JELLYFIN_TASK_ID=

# Minimum seconds between automatic Jellyfin guide-refresh triggers after a
# scrape actually changes the guide. [Advanced Settings: not exposed there;
# env-only]
#JELLYFIN_AUTO_REFRESH_MIN_INTERVAL=600

# ==========================================================================
# Alerts
# ==========================================================================

#DISCORD_WEBHOOK_URL=
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# ==========================================================================
# Providers / scraping
# ==========================================================================

# Aggregator base URLs. Numbering has gaps (no 7/8) reflecting providers
# retired over time; each is also editable live from the dashboard's
# Provider Domains card (Alerts & Integrations tab), which takes precedence
# once saved.
#AGGREGATOR_1_URL=https://isportsurge.ws
#AGGREGATOR_2_URL=https://mybuffstreams.plus
#AGGREGATOR_3_URL=https://methstreams.click
#AGGREGATOR_4_URL=https://thestreameast.top
#AGGREGATOR_5_URL=https://thetvapp67.com
#AGGREGATOR_6_URL=https://dlhd.pk
#AGGREGATOR_9_URL=https://footybite.im
#AGGREGATOR_10_URL=https://1stream.ws
#AGGREGATOR_11_URL=https://streamed.su
#AGGREGATOR_12_URL=https://topstreams.info

# Extra channel-name substrings (comma-separated) that mark a candidate as
# non-English, in addition to the built-in list.
#EXTRA_NON_ENGLISH_MARKERS=

# iptv-org sports playlist used as a fallback/supplemental source.
#IPTV_ORG_PLAYLIST_URL=https://iptv-org.github.io/iptv/categories/sports.m3u
#IPTV_ORG_REFRESH_SECONDS=21600

# ESPN college team-directory refresh cadence, and retry delay after a
# failed refresh.
#CATALOG_REFRESH_SECONDS=3600
#CATALOG_FAILURE_RETRY_SECONDS=120

# How many events (schedule entries) a single provider search is allowed to
# return / concurrent per-event fetches within a search.
#MAX_PROVIDER_EVENTS=60
#PROVIDER_EVENT_CONCURRENCY=6
#PROVIDER_EVENT_TIMEOUT=20

# Provider search concurrency, timeout, and per-team concurrency.
#PROVIDER_SEARCH_CONCURRENCY=6
#PROVIDER_SEARCH_TIMEOUT=45
#PER_TEAM_PROVIDER_CONCURRENCY=3

# Dynamic per-provider search timeout bounds; the live value is learned from
# recent successful searches and clamped to this range.
#PROVIDER_TIMEOUT_MIN=20
#PROVIDER_TIMEOUT_MAX=90
#PROVIDER_TIMEOUT_DEFAULT=45

# Circuit breaker: consecutive failures before a provider is skipped, and
# how long it stays skipped. [Advanced Settings: Scraping group]
#PROVIDER_BREAKER_FAILURES=3
#PROVIDER_BREAKER_COOLDOWN=120

# Concurrent stream-liveness verifications, and the cap on candidates kept
# per channel. [MAX_STREAM_CANDIDATES: Advanced Settings, Scraping group]
#VERIFY_STREAM_CONCURRENCY=6
#MAX_STREAM_CANDIDATES=24

# How long a fetched aggregator index/category page is cached and
# single-flighted before it's re-fetched.
#SCRAPE_INDEX_CACHE_SECONDS=60

# How long a headless Chromium instance is kept before being recycled
# (0 disables recycling).
#PLAYWRIGHT_RECYCLE_HOURS=6

# Max concurrent Playwright pages open at once, across all scrapers.
#PLAYWRIGHT_MAX_PAGES=3

# ==========================================================================
# Health & failover
# ==========================================================================
# Most of these are also editable live from the dashboard's Advanced
# Settings (Settings tab, "Health & failover" / "Scraping" groups) — a
# saved override there takes effect immediately without a restart.

# How often the active source of a watched channel is health-checked.
#ACTIVE_HEALTH_INTERVAL=3

# How often a channel nobody is watching is checked, and how many of those
# checks run concurrently.
#IDLE_HEALTH_INTERVAL=30

# Standby (backup) candidate check interval for watched vs. unwatched
# channels, and how many standby checks run concurrently.
#STANDBY_HEALTH_INTERVAL=45
#UNWATCHED_STANDBY_INTERVAL=300
#STANDBY_HEALTH_CONCURRENCY=4
#ACTIVE_HEALTH_CONCURRENCY=8
#STANDBY_PROBES_PER_CHANNEL=5

# Consecutive failed probes before a channel fails over, and the probe's
# own timeout.
#HEALTH_FAILURE_THRESHOLD=2
#HEALTH_PROBE_TIMEOUT=12

# Recovery probe interval once every source for a channel has failed.
#EXHAUSTED_PROBE_INTERVAL=20

# Minimum seconds between emergency rescans triggered by a channel going
# fully dark for one team/channel.
#EMERGENCY_SCRAPE_COOLDOWN=60

# Refresh standby candidates of an already-healthy channel this often
# instead of every rescrape cycle.
#HEALTHY_RESCRAPE_SECONDS=1800

# Spread rescrapes across this many seconds at startup instead of firing
# them all at once.
#STARTUP_SCRAPE_SPREAD_SECONDS=45

# Keep a channel on-air without playback for this long after its game
# window closes, before tearing it down.
#WINDOW_CLOSE_GRACE_SECONDS=180

# Retries of a channel's only known source before giving up to "No Signal",
# and the rolling window those retries are counted over.
#SELF_RETRY_LIMIT=2
#SELF_RETRY_WINDOW=120

# How long a source marked "incompatible" (wrong container/codec for the
# session engine) is skipped before being retried.
#INCOMPATIBLE_RETRY_SECONDS=3600

# Minimum seconds between failover alert notifications, per channel.
#FAILOVER_ALERT_COOLDOWN=300

# Minimum seconds between automatic auth-token refreshes on a 401/403.
#TOKEN_REFRESH_COOLDOWN=120

# How long a candidate is considered "known good" / how long a failed
# candidate is skipped before being retried, when rebuilding a channel's
# candidate list.
#CANDIDATE_GOOD_FOR_SECONDS=180
#CANDIDATE_FAILED_RETRY_AFTER=60

# ==========================================================================
# Channel sessions (the per-channel HLS engine behind /stream/{id}.m3u8)
# ==========================================================================

# Stop a channel's session after this many idle seconds (no requests).
# [Advanced Settings: Channel sessions]
#SESSION_IDLE_SECONDS=60

# How long to wait for a channel to produce its first segment before
# showing "No Signal". [Advanced Settings: Channel sessions]
#STREAM_STARTUP_TIMEOUT=20

# How long "No Signal" is shown for a slow-starting channel before giving
# up. [Advanced Settings: Channel sessions]
#STARTUP_PLACEHOLDER_SECONDS=30

# Per-client bandwidth cap in bits/second for served streams (0 = no cap).
#STREAM_MAX_BANDWIDTH=0

# Channel session engine (also editable live in Advanced Settings).
#SESSION_LIVE_EDGE_SEGMENTS=3
#SESSION_WINDOW_SECONDS=30
#SESSION_STALE_SECONDS=15
#SESSION_FAIL_THRESHOLD=3
#SESSION_SEGMENT_TIMEOUT=15

# ==========================================================================
# Multi-View
# ==========================================================================

# ffmpeg binary used for Multi-View compositing. Resolution order when
# unset: MULTIVIEW_FFMPEG_PATH -> FFMPEG_PATH -> Jellyfin's own ffmpeg (if
# installed on this machine) -> the bundled binary (Windows exe builds
# that included one).
#FFMPEG_PATH=
#MULTIVIEW_FFMPEG_PATH=

# Encoder backend: nvenc (NVIDIA), qsv (Intel Quick Sync), or none
# (software libx264).
#MULTIVIEW_HWACCEL=nvenc

# Target video bitrate for a composited output.
#MULTIVIEW_BITRATE=6M

# HLS segment duration (seconds) and playlist length (segment count) for
# Multi-View output.
#MULTIVIEW_SEGMENT_SECONDS=4
#MULTIVIEW_HLS_LIST_SIZE=8

# Output frame rate (also drives the forced-keyframe GOP with the segment
# length above).
#MULTIVIEW_FPS=30

# NVENC preset/tune (ignored - and logged - if not one of ffmpeg's known
# values).
#MULTIVIEW_NVENC_PRESET=p4
#MULTIVIEW_NVENC_TUNE=ll

# After an NVENC failure, stay on software encoding for this long before
# retrying hardware again.
#NVENC_FALLBACK_SECONDS=600

# Stop an unwatched Multi-View ffmpeg process after this many idle seconds,
# and how often the idle monitor scans for that.
#MULTIVIEW_IDLE_TIMEOUT_SECONDS=180
#MULTIVIEW_IDLE_CHECK_INTERVAL=30

# Max seconds to wait for the first HLS segment before failing a Multi-View
# request, and per-member warm-up timeout.
#MULTIVIEW_STARTUP_TIMEOUT_SECONDS=30
#MULTIVIEW_MEMBER_WARM_TIMEOUT=20

# Max Multi-View grids allowed to run concurrently.
#MAX_CONCURRENT_MULTIVIEW=3

# Whether member audio is also exposed as separate per-audio channels
# (/multiview/{id}/audio-N.m3u8). Set to 0/false/no to disable.
#MULTIVIEW_AUDIO_CHANNELS=1

# Spawn-failure backoff: base and max delay between retrying a failed
# ffmpeg spawn.
#MULTIVIEW_BACKOFF_BASE_SECONDS=15
#MULTIVIEW_BACKOFF_MAX_SECONDS=300

# Watchdog restart backoff: this many restarts inside the rolling window
# are immediate; further ones back off exponentially.
#MULTIVIEW_RESTART_WINDOW_SECONDS=600
#MULTIVIEW_RESTART_BURST=2

# Backoff after a refused Multi-View start (concurrency cap / no ffmpeg).
#MULTIVIEW_REFUSAL_BACKOFF_SECONDS=5

# How often the watchdog checks running Multi-View processes for stalls.
#MULTIVIEW_WATCHDOG_INTERVAL=3

# How often leftover Multi-View run directories are swept from disk.
#MULTIVIEW_SWEEP_INTERVAL=600

# ffmpeg log verbosity for Multi-View processes (info enables -stats).
#MULTIVIEW_FFMPEG_LOGLEVEL=warning

# Idle timeout for the placeholder ("No Signal") ffmpeg process.
#PLACEHOLDER_IDLE_SECONDS=900

# ==========================================================================
# Legacy proxy (fMP4 / demuxed-audio / SAMPLE-AES sources; the older
# chunk-relay path used when a source can't go through the session engine)
# ==========================================================================
# All of these are also in Advanced Settings, "Legacy proxy" group.

# Warm-up cache time before serving the first chunk.
#STREAM_STARTUP_BUFFER_SECONDS=15

# Read-ahead chunk count and concurrency.
#PREFETCH_CHUNK_COUNT=5
#PREFETCH_CONCURRENCY=2

# Completed-chunk cache: how many chunks are held, how long, and the total
# byte cap.
#STREAM_CHUNK_CACHE_CAPACITY=60
#STREAM_CHUNK_CACHE_TTL=15
#STREAM_CHUNK_CACHE_MAX_BYTES=134217728

# Byte caps for a fetched manifest, a generic proxied resource, and the
# largest chunk that's still eligible for caching.
#MAX_MANIFEST_BYTES=2097152
#MAX_RESOURCE_BYTES=8388608
#MAX_CACHEABLE_CHUNK_BYTES=4194304

# Maximum redirects the legacy proxy will follow upstream.
#MAX_UPSTREAM_REDIRECTS=3

# ==========================================================================
# Update check
# ==========================================================================

# Where the opt-in update checker looks for the latest release (GitHub
# Releases API by default).
#UPDATE_CHECK_URL=https://api.github.com/repos/DarthBitBeard/Jellyball/releases/latest

# ==========================================================================
# Paths & runtime (advanced / packaging use)
# ==========================================================================

# Set automatically by the app; override only if you know you need a
# non-default Playwright browser cache location.
#PLAYWRIGHT_BROWSERS_PATH=
