# Copy to `.env` next to docker-compose.yml.
# Full annotated template (every setting): Jellyball/.env.example
#
# The Docker volume ./data is owned by uid 1000 (USER jellyball in the image).
# On first run, ensure the host directory is writable by that user, e.g.:
#   mkdir -p data && sudo chown 1000:1000 data

#PORT=8000
#DASHBOARD_USERNAME=admin
#DASHBOARD_PASSWORD=
#MULTIVIEW_HWACCEL=none
#JELLYFIN_URL=
#JELLYFIN_API_KEY=
#DISCORD_WEBHOOK_URL=
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#STREAM_PROVIDER_PRIORITY=
#STREAM_MAX_BANDWIDTH=
#TRUST_X_FORWARDED_HOST=0
